@model CastingSolution.Models.DTOs.PromotorDetalheDTO.PromotorDetalheDTO
@using CastingSolution.Models.Enums
@{
    ViewData["Title"] = "Detalhes do Promotor";
    var statusAtivo = Model.Status == StatusPromotor.Ativo;
}

<div class="p-4 md:p-8 max-w-6xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
            <a asp-action="ListarPromotores" class="btn btn-outline btn-primary btn-sm">&larr; Voltar para promotores</a>
            <h1 class="text-3xl font-bold text-primary mt-2">@Model.Nome</h1>
            <p class="text-base-300 mt-1">Detalhes e informações cadastrais</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="badge @(statusAtivo ? "badge-success" : "badge-error")">@Model.Status</span>
            @if (Model.IsFavorito)
            {
                <span class="badge badge-warning">Favorito</span>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <section class="card bg-base-200 shadow-lg lg:col-span-2">
            <div class="card-body">
                <h2 class="card-title text-primary">Informações pessoais</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5 mt-4">
                    <div>
                        <p class="text-sm text-base-300">Nome</p>
                        <p class="font-semibold">@(Model.Nome ?? "Não informado")</p>
                    </div>
                    <div>
                        <p class="text-sm text-base-300">E-mail</p>
                        <p class="font-semibold break-words">@(Model.Email ?? "Não informado")</p>
                    </div>
                    <div>
                        <p class="text-sm text-base-300">Telefone</p>
                        <p class="font-semibold">@(Model.Telefone ?? "Não informado")</p>
                    </div>
                    <div>
                        <p class="text-sm text-base-300">Data de nascimento</p>
                        <p class="font-semibold">@(Model.DataNascimento?.ToString("dd/MM/yyyy") ?? "Não informado")</p>
                    </div>
                    <div>
                        <p class="text-sm text-base-300">Cidade</p>
                        <p class="font-semibold">@(Model.Cidade ?? "Não informado")</p>
                    </div>
                    <div>
                        <p class="text-sm text-base-300">Função principal</p>
                        <p class="font-semibold">@(Model.FuncaoPrincipal ?? "Não informado")</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="card bg-base-200 shadow-lg">
            <div class="card-body">
                <h2 class="card-title text-primary">Avaliação</h2>
                <div class="flex items-center gap-3 mt-4">
                    <span class="text-4xl font-bold">@(Model.Nota?.ToString() ?? "-")</span>
                    <span class="text-base-300">/ 10</span>
                </div>
                <div class="divider"></div>
                <div>
                    <p class="text-sm text-base-300">Status</p>
                    <p class="font-semibold">@Model.Status</p>
                </div>
            </div>
        </section>

        <section class="card bg-base-200 shadow-lg lg:col-span-2">
            <div class="card-body">
                <h2 class="card-title text-primary">Características</h2>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-5 mt-4">
                    <div>
                        <p class="text-sm text-base-300">Altura</p>
                        <p class="font-semibold">@(Model.Altura.HasValue ? $"{Model.Altura} cm" : "Não informado")</p>
                    </div>
                    <div>
                        <p class="text-sm text-base-300">Gênero</p>
                        <p class="font-semibold">@(Model.Genero?.ToString() ?? "Não informado")</p>
                    </div>
                    <div>
                        <p class="text-sm text-base-300">Cor dos olhos</p>
                        <p class="font-semibold">@(Model.CorOlhos ?? "Não informado")</p>
                    </div>
                    <div>
                        <p class="text-sm text-base-300">Cor do cabelo</p>
                        <p class="font-semibold">@(Model.CorCabelo ?? "Não informado")</p>
                    </div>
                    <div>
                        <p class="text-sm text-base-300">Tamanho da camiseta</p>
                        <p class="font-semibold">@(Model.TamanhoCamiseta ?? "Não informado")</p>
                    </div>
                    <div>
                        <p class="text-sm text-base-300">Tamanho da calça</p>
                        <p class="font-semibold">@(Model.TamanhoCalca ?? "Não informado")</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="card bg-base-200 shadow-lg">
            <div class="card-body">
                <h2 class="card-title text-primary">Arquivos</h2>
                <div class="stats stats-vertical shadow-none mt-2">
                    <div class="stat px-0">
                        <div class="stat-title">Fotos cadastradas</div>
                        <div class="stat-value text-2xl">@Model.Fotos.Count</div>
                    </div>
                    <div class="stat px-0">
                        <div class="stat-title">Documentos cadastrados</div>
                        <div class="stat-value text-2xl">@Model.Documentos.Count</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="card bg-base-200 shadow-lg lg:col-span-2">
            <div class="card-body">
                <h2 class="card-title text-primary">Observações</h2>
                <p class="mt-3 whitespace-pre-line">@(Model.Observacoes ?? "Nenhuma observação cadastrada.")</p>
            </div>
        </section>

        <section class="card bg-base-200 shadow-lg">
            <div class="card-body">
                <h2 class="card-title text-primary">Documentos</h2>
                @if (Model.Documentos.Any())
                {
                    <ul class="mt-3 space-y-2">
                        @foreach (var doc in Model.Documentos)
                        {
                            <li class="flex items-center gap-2 text-sm">
                                <span class="badge badge-ghost badge-sm">📄</span>
                                <span class="font-medium break-all">@doc.NomeArquivo</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="mt-3 text-base-300 text-sm">Nenhum documento cadastrado.</p>
                }
            </div>
        </section>
    </div>

    <section class="card bg-base-200 shadow-lg mt-6">
        <div class="card-body">
            <div class="flex items-center justify-between gap-4">
                <h2 class="card-title text-primary">Fotos</h2>
                <span class="badge badge-ghost">@Model.Fotos.Count foto(s)</span>
            </div>

            @if (Model.Fotos.Any())
            {
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 mt-4">
                    @foreach (var foto in Model.Fotos)
                    {
                        <div class="relative aspect-[3/4] rounded-lg overflow-hidden border border-base-300 bg-base-300">
                            <img src="@Url.Action("Foto", "Promotores", new { id = foto.Id })"
                                 alt="Foto de @Model.Nome"
                                 class="w-full h-full object-cover"
                                 loading="lazy" />
                            @if (foto.IsPrincipal)
                            {
                                <span class="absolute top-2 left-2 badge badge-primary badge-sm">Principal</span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="border border-dashed border-base-300 rounded-lg text-center text-base-300 py-10 mt-4">
                    Nenhuma foto cadastrada.
                </div>
            }
        </div>
    </section>
</div>

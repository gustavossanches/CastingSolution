@model CastingSolution.Models.DTOs.HomeViewModel
@{
    ViewData["Title"] = "Início";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-bordo">Eventos Ativos</h2>
            <p class="text-cinza">Acompanhe os eventos em andamento</p>
        </div>
    </div>

    @if (Model.EventosAtivos.Any())
    {
        <div class="row g-4">
            @foreach (var evento in Model.EventosAtivos)
            {
                <div class="col-12">
                    <div class="card card-evento shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start flex-wrap">
                                <div class="mb-2">
                                    <h4 class="card-title fw-bold mb-1">@evento.Cliente</h4>
                                    <p class="text-cinza mb-2"><i class="bi bi-geo-alt"></i> @evento.Local</p>
                                </div>
                                <span class="badge badge-rosa fs-6">Ativo</span>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-4 mb-2">
                                    <small class="text-cinza d-block">Início</small>
                                    <span class="fw-semibold">@evento.DataInicio.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-cinza d-block">Término</small>
                                    <span class="fw-semibold">@evento.DataFim.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <small class="text-cinza d-block">Valor Cobrado</small>
                                    <span class="fw-semibold text-bordo">R$ @evento.ValorCobrado.ToString("N2")</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(evento.DetalhesEvento))
                            {
                                <div class="mt-3">
                                    <small class="text-cinza d-block">Detalhes</small>
                                    <p class="mb-0">@evento.DetalhesEvento</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm box-vazio">
                    <div class="card-body p-5 text-center">
                        <div class="mb-3 text-bordo">
                            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-calendar-x" viewBox="0 0 16 16">
                                <path d="M6.146 7.146a.5.5 0 0 1 .708 0L8 8.293l1.146-1.147a.5.5 0 1 1 .708.708L8.707 9l1.147 1.146a.5.5 0 0 1-.708.708L8 9.707l-1.146 1.147a.5.5 0 0 1-.708-.708L7.293 9 6.146 7.854a.5.5 0 0 1 0-.708z"/>
                                <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                            </svg>
                        </div>
                        <h3 class="fw-bold mb-2">Nenhum evento ativo no momento</h3>
                        <p class="mb-0 text-cinza">Cadastre um novo evento para começar a gerenciar seus castings.</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

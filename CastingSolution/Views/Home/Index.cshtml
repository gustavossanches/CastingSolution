@model CastingSolution.Models.DTOs.HomeViewModel
@{
    ViewData["Title"] = "Início";
}

<div class="p-6">
    <div class="mb-8">
        <h2 class="text-3xl font-bold text-primary">Eventos Ativos</h2>
        <p class="text-base-300 mt-1">Acompanhe os eventos em andamento</p>
    </div>

    @if (Model.EventosAtivos.Any())
    {
        <div class="grid grid-cols-1 gap-6">
            @foreach (var evento in Model.EventosAtivos)
            {
                <div class="card bg-base-200 shadow-md border-l-4 border-primary">
                    <div class="card-body">
                        <div class="flex flex-wrap justify-between items-start gap-4">
                            <div>
                                <h3 class="card-title text-xl text-neutral">@evento.Cliente</h3>
                                <p class="text-base-300 flex items-center gap-2 mt-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A31.493 31.493 0 0 1 8 14.58a31.481 31.481 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.304 1.867-.834 2.94zM8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10z"/>
                                        <path d="M8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm0 1a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                                    </svg>
                                    @evento.Local
                                </p>
                            </div>
                            <span class="badge badge-primary">Ativo</span>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                            <div>
                                <p class="text-sm text-base-300">Início</p>
                                <p class="font-semibold text-neutral">@evento.DataInicio.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                            <div>
                                <p class="text-sm text-base-300">Término</p>
                                <p class="font-semibold text-neutral">@evento.DataFim.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                            <div>
                                <p class="text-sm text-base-300">Valor Cobrado</p>
                                <p class="font-semibold text-primary">R$ @evento.ValorCobrado.ToString("N2")</p>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(evento.DetalhesEvento))
                        {
                            <div class="mt-4 pt-4 border-t border-base-300">
                                <p class="text-sm text-base-300">Detalhes</p>
                                <p class="text-neutral">@evento.DetalhesEvento</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card bg-secondary/20 shadow-sm">
            <div class="card-body items-center text-center py-12">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="text-primary mb-4" viewBox="0 0 16 16">
                    <path d="M6.146 7.146a.5.5 0 0 1 .708 0L8 8.293l1.146-1.147a.5.5 0 1 1 .708.708L8.707 9l1.147 1.146a.5.5 0 0 1-.708.708L8 9.707l-1.146 1.147a.5.5 0 0 1-.708-.708L7.293 9 6.146 7.854a.5.5 0 0 1 0-.708z"/>
                    <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                </svg>
                <h3 class="card-title text-xl text-neutral">Nenhum evento ativo no momento</h3>
                <p class="text-base-300">Cadastre um novo evento para começar a gerenciar seus castings.</p>
                <div class="card-actions mt-4">
                    <a asp-controller="Eventos" asp-action="Create" class="btn btn-primary">Criar Evento</a>
                </div>
            </div>
        </div>
    }
</div>

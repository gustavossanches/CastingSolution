@model CastingSolution.Models.Evento
@{
    ViewData["Title"] = "Criar Evento";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-branco shadow-sm">
                <div class="card-body p-4">
                    <h2 class="fw-bold text-bordo mb-1">Criar Evento</h2>
                    <p class="text-cinza mb-4">Preencha os dados do novo evento</p>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Cliente" class="form-label fw-semibold">Cliente</label>
                                <input asp-for="Cliente" class="form-control" placeholder="Nome do cliente" />
                                <span asp-validation-for="Cliente" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Local" class="form-label fw-semibold">Local</label>
                                <input asp-for="Local" class="form-control" placeholder="Local do evento" />
                                <span asp-validation-for="Local" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DetalhesEvento" class="form-label fw-semibold">Detalhes do Evento</label>
                            <textarea asp-for="DetalhesEvento" class="form-control" rows="3" placeholder="Descreva o serviço que será prestado"></textarea>
                            <span asp-validation-for="DetalhesEvento" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DataInicio" class="form-label fw-semibold">Data e Hora de Início</label>
                                <input asp-for="DataInicio" type="datetime-local" class="form-control" />
                                <span asp-validation-for="DataInicio" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DataFim" class="form-label fw-semibold">Data e Hora de Término</label>
                                <input asp-for="DataFim" type="datetime-local" class="form-control" />
                                <span asp-validation-for="DataFim" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ValorCobrado" class="form-label fw-semibold">Valor Cobrado do Cliente</label>
                                <input asp-for="ValorCobrado" type="number" step="0.01" class="form-control" placeholder="0,00" />
                                <span asp-validation-for="ValorCobrado" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ValorPromotores" class="form-label fw-semibold">Valor dos Promotores</label>
                                <input asp-for="ValorPromotores" type="number" step="0.01" class="form-control" placeholder="0,00" />
                                <span asp-validation-for="ValorPromotores" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-bordo">Criar Evento</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model CastingSolution.Models.Evento
@{
    ViewData["Title"] = "Criar Evento";
}

<div>
    <div>
        <div>
            <div>
                <h2>Criar Evento</h2>
                <p>Preencha os dados do novo evento</p>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly"></div>

                    <div>
                        <div>
                            <label asp-for="Cliente">Cliente</label>
                            <input asp-for="Cliente" placeholder="Nome do cliente" />
                            <span asp-validation-for="Cliente"></span>
                        </div>
                        <div>
                            <label asp-for="Local">Local</label>
                            <input asp-for="Local" placeholder="Local do evento" />
                            <span asp-validation-for="Local"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="DetalhesEvento">Detalhes do Evento</label>
                        <textarea asp-for="DetalhesEvento" rows="3" placeholder="Descreva o serviço que será prestado"></textarea>
                        <span asp-validation-for="DetalhesEvento"></span>
                    </div>

                    <div>
                        <div>
                            <label asp-for="DataInicio">Data e Hora de Início</label>
                            <input asp-for="DataInicio" type="datetime-local" />
                            <span asp-validation-for="DataInicio"></span>
                        </div>
                        <div>
                            <label asp-for="DataFim">Data e Hora de Término</label>
                            <input asp-for="DataFim" type="datetime-local" />
                            <span asp-validation-for="DataFim"></span>
                        </div>
                    </div>

                    <div>
                        <div>
                            <label asp-for="ValorCobrado">Valor Cobrado do Cliente</label>
                            <input asp-for="ValorCobrado" type="number" step="0.01" placeholder="0,00" />
                            <span asp-validation-for="ValorCobrado"></span>
                        </div>
                        <div>
                            <label asp-for="ValorPromotores">Valor dos Promotores</label>
                            <input asp-for="ValorPromotores" type="number" step="0.01" placeholder="0,00" />
                            <span asp-validation-for="ValorPromotores"></span>
                        </div>
                    </div>

                    <div>
                        <a asp-controller="Home" asp-action="Index">Cancelar</a>
                        <button type="submit">Criar Evento</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
